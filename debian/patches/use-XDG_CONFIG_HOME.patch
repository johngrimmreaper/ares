Description: Use $XDG_CONFIG_HOME
 higan stores its config files in ~/.config.  This patch makes it use
 XDG_CONFIG_HOME instead, if set.
Author: Michael Gold <michael@bitplane.org>
Bug-Debian: http://bugs.debian.org/738270

--- a/nall/path.hpp
+++ b/nall/path.hpp
@@ -80,7 +80,13 @@
   #elif defined(PLATFORM_MACOS)
   string result = {Path::user(), "Library/Application Support/"};
   #else
-  string result = {Path::user(), ".config/"};
+  string result;
+  const char *env = getenv("XDG_CONFIG_HOME");
+  if(env) {
+    result.append(env);
+  } else {
+    result = {Path::user(), ".config/"};
+  }
   #endif
   if(!result) result = ".";
   if(!result.endsWith("/")) result.append("/");
