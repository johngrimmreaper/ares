#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS=hardening=+all qa=+all

DEB_BUILD_ARCH_CPU ?= $(shell dpkg-architecture -qDEB_BUILD_ARCH_CPU)

# DEB_VERSION
include /usr/share/dpkg/pkg-info.mk

CMAKE_OPTIONS := \
	-DARES_BUILD_LOCAL=OFF \
	-DARES_ENABLE_MINIMUM_CPU=OFF \
	-DARES_SKIP_DEPS=ON \
	-DARES_VERSION_OVERRIDE="v$(DEB_VERSION)" \
	-DWITH_SYSTEM_ZLIB=ON

# Reimplementation of older disable-md-on-32bit.patch
ifneq ($(shell $(CXX) -E -dM - < /dev/null | grep INT128),)
	md_support += ;md
endif

ifeq (,$(filter noopt,$(DEB_BUILD_OPTIONS)))
    BUILDOPT=RelWithDebInfo
else
    BUILDOPT=Debug
endif

# arch.no-n64 = ares-baseline
# arch.with-n64 = ares-performance
ifeq ($(DEB_HOST_ARCH_CPU),amd64)
arch.no-n64: export arch_level = -march=x86-64
endif
arch.no-n64: export cores = a26;fc;sfc;sg;ms;ps1;pce;ng;msx;cv;myvision;gb;gba;ws;ngp;spec $(md_support)
arch.no-n64: export destdir = debian/tmp/ares-baseline
arch.no-n64: export binaryname = ares-baseline

ifeq ($(DEB_HOST_ARCH_CPU),amd64)
arch.with-n64: export arch_level = -march=x86-64-v2
endif
arch.with-n64: export cores = a26;fc;sfc;sg;ms;ps1;pce;ng;msx;cv;myvision;gb;gba;ws;ngp;spec;n64 $(md_support)
arch.with-n64: export destdir = debian/tmp/ares-performance
arch.with-n64: export binaryname = ares-performance

arch.no-n64:
	dh_auto_clean
	dh build --destdir=$(destdir) -p ares-baseline -N ares-performance
	dh binary --destdir=$(destdir) -p ares-baseline -N ares-performance

arch.with-n64:
	dh_auto_clean
	dh build --destdir=$(destdir) -p ares-performance -N ares-baseline
	dh binary --destdir=$(destdir) -p ares-performance -N ares-baseline

clean:
	dh clean

binary: binary-arch binary-indep

# Don't build targets on architechtures with no package for them
ifeq ($(DEB_HOST_ARCH_CPU),amd64)
binary-arch: arch.no-n64 arch.with-n64
else ifeq ($(DEB_HOST_ARCH_CPU),arm64)
binary-arch: arch.with-n64
else
binary-arch: arch.no-n64
endif

binary-indep:

build: build-arch build-indep

build-arch:

build-indep:

override_dh_auto_configure:
	DEB_CFLAGS_MAINT_APPEND=$(arch_level) DEB_CXXFLAGS_MAINT_APPEND=$(arch_level)  dh_auto_configure --reload-all-buildenv-variables -- \
	$(CMAKE_OPTIONS) \
	-DCMAKE_BUILD_TYPE=$(BUILDOPT) \
	-DARES_CORES="$(cores)"

override_dh_builddeb:
	dh_builddeb --destdir=..
