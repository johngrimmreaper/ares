#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS=hardening=+all qa=+all

DEB_BUILD_ARCH_CPU ?= $(shell dpkg-architecture -qDEB_BUILD_ARCH_CPU)

# DEB_VERSION
include /usr/share/dpkg/pkg-info.mk

CMAKE_OPTIONS := \
	-DARES_BUILD_LOCAL=OFF \
	-DARES_ENABLE_MINIMUM_CPU=OFF \
	-DARES_SKIP_DEPS=ON \
	-DARES_VERSION_OVERRIDE="v$(DEB_VERSION)" \
	-DWITH_SYSTEM_ZLIB=ON

# Reimplementation of older disable-md-on-32bit.patch
ifneq ($(shell $(CXX) -E -dM - < /dev/null | grep INT128),)
	md_support += ;md
endif

ifeq (,$(filter noopt,$(DEB_BUILD_OPTIONS)))
    BUILDOPT=RelWithDebInfo
else
    BUILDOPT=Debug
endif

# arch.no-n64 = ares-legacy
# arch.with-n64 = ares-full
ifeq ($(DEB_HOST_ARCH_CPU),amd64)
arch.no-n64: export DEB_CFLAGS_MAINT_APPEND = -march=x86-64
arch.no-n64: export DEB_CXXFLAGS_MAINT_APPEND = -march=x86-64
arch.no-n64: export cores = a26;fc;sfc;sg;ms;ps1;pce;ng;msx;cv;myvision;gb;gba;ws;ngp;spec $(md_support)

arch.with-n64: export DEB_CFLAGS_MAINT_APPEND = -march=x86-64-v2
arch.with-n64: export DEB_CXXFLAGS_MAINT_APPEND = -march=x86-64-v2
arch.with-n64: export cores = a26;fc;sfc;sg;ms;ps1;pce;ng;msx;cv;myvision;gb;gba;ws;ngp;spec;n64 $(md_support)
endif

arch.no-n64:
	dh build --destdir=debian/tmp/ares-legacy -p ares-legacy
	dh binary --destdir=debian/tmp/ares-legacy -p ares-legacy

arch.with-n64:
	dh build --destdir=debian/tmp/ares-full -p ares-full
	dh binary --destdir=debian/tmp/ares-full -p ares-full

clean:
	dh clean

binary: binary-arch binary-indep

binary-arch: arch.no-n64 arch.with-n64 binary-indep

binary-indep:

build: build-arch build-indep

build-indep:

build-arch:

override_dh_auto_configure:
	dh_auto_configure --reload-all-buildenv-variables -- \
	$(CMAKE_OPTIONS) \
	-DCMAKE_BUILD_TYPE=$(BUILDOPT) \
	-DARES_CORES="$(cores)"

override_dh_builddeb:
	dh_builddeb --destdir=..
